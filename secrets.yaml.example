# Copy to secrets.yaml (which is git-ignored) and fill in real values.
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"
# Generate with: openssl rand -base64 32
api_key: "generate-a-new-base64-key"
# Fallback hotspot password, at least 8 characters
ap_password: "choose-a-fallback-password"
# Octopus meter ID in the form <serial>_<mpan>
octopus_meter_id: "serial_mpan"
